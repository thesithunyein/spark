# Copy to contracts/.env (which .gitignore excludes) and fill in.
#
# Never commit this file. The key below is never printed by any script in this repo.

# Deployer key. For CC3 this must hold testnet CTC for gas.
# The address derived from it is logged before anything is broadcast.
PRIVATE_KEY=

# Creditcoin CC3 testnet. Chain id 102031.
CC3_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Attested source chain for the position engine. 3 = Ethereum mainnet.
# Measured live via get_supported_chains() on the 0x0FD3 precompile.
CHAIN_KEY=3

# Bounds enforced on-chain by MainnetPositionRegistry.
# A residual above this reverts, because a large residual means missing history,
# not large interest. 1000 bps = 10%.
MAX_RESIDUAL_BPS=1000

# Attested price staleness ceiling, in seconds.
MAX_STALENESS=86400
