# Env template for the app, for Vercel and for local dev.
#
# This file is the copy used for Vercel Project Env. For local development
# `app/.env.example` is the canonical one and already carries the deployed
# addresses; the README's install path copies that.
#
# Note NEXT_PUBLIC_ATTESTCOIN. config.ts reads it as `=== "true"`, so anything
# other than the literal string `true` runs the app WITHOUT the Attestcoin proof
# path, silently. This file previously omitted the variable, which meant copying
# it in as-is produced an app that looked right and verified nothing.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- RPC endpoints ---
NEXT_PUBLIC_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_CREDITCOIN_RPC=https://rpc.cc3-testnet.creditcoin.network

# --- Chain ids ---
NEXT_PUBLIC_CHAIN_PAYMENT_ID=11155111
NEXT_PUBLIC_CHAIN_CREDIT_ID=102031

# --- Deployed contracts (production values: docs/addresses.md) ---
NEXT_PUBLIC_PAYMENT_ADDRESS=0x63F0c69cf9F8b53E8eDD141d07fF2eEd2237ccc4
NEXT_PUBLIC_CREDITLINE_ADDRESS=0x2C3585019B957b16459C409f34973b583267C742
NEXT_PUBLIC_CREDIT_TOKEN_ADDRESS=0x1BaDE07F2F3295528a2F7316119813b6846dFfaD
NEXT_PUBLIC_VERIFIER_ADDRESS=0xF13205Bdf48A3159d4A46309C639930aE8faC130

# --- Legacy stack: keeps an older line repayable after a contract change ---
NEXT_PUBLIC_LEGACY_CREDITLINE_ADDRESS=0x1Ba750b08dC4C06B993DfDedE45d22cbD540D319
NEXT_PUBLIC_LEGACY_PAYMENT_ADDRESS=0x4B137F56A0b5A8633D079d2d6b34d6aC5CdD22E9

# --- Attestcoin / USC ---
NEXT_PUBLIC_ATTESTCOIN=true
NEXT_PUBLIC_PROVER_URL=https://proof-gen-api.cc3-testnet.creditcoin.network

# --- Block explorers ---
NEXT_PUBLIC_EXPLORER_SEPOLIA=https://sepolia.etherscan.io
NEXT_PUBLIC_EXPLORER_CREDITCOIN=https://creditcoin-testnet.blockscout.com

# --- Optional ---
NEXT_PUBLIC_WALLETCONNECT_ID=your_walletconnect_project_id

# Contracts deploy only (never put on Vercel) - contracts/.env
# PRIVATE_KEY=
# SEPOLIA_RPC_URL=
# CREDITCOIN_RPC_URL=
